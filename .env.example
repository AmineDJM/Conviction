# OpenAI key. In managed environments the outbound proxy may inject it; leave empty then.
OPENAI_API_KEY=
# Primary multimodal reasoning model (Luna-first architecture).
CONVICTION_MODEL=gpt-5.6-luna
# SQLite database file (created on first run).
DATABASE_PATH=./data/conviction.db
# Where uploaded documents are stored (encrypted-at-rest is the deployment's responsibility).
STORAGE_DIR=./data/uploads
# Session secret for signed cookies (32+ random chars).
SESSION_SECRET=change-me-to-a-long-random-string
# Hard cap per standard analysis in USD (enforced in code; cannot exceed 0.50 for STANDARD).
STANDARD_BUDGET_USD=0.50
# Behind an egress proxy that injects credentials (Node >= 22.21): make fetch honor HTTPS_PROXY.
# NODE_USE_ENV_PROXY=1
