# ── Required ────────────────────────────────────────────────────────────────
# OpenAI key. In managed environments the outbound proxy may inject it; leave empty then.
OPENAI_API_KEY=
# Session secret for signed cookies (32+ random chars). render.yaml generates it.
SESSION_SECRET=change-me-to-a-long-random-string

# ── Storage (defaults work locally; render.yaml sets the disk paths) ────────
DATABASE_PATH=./data/conviction.db
STORAGE_DIR=./data/uploads
# Key for AES-256-GCM encryption of documents, transcripts and integration tokens (render.yaml generates it).
# DATA_ENCRYPTION_KEY=
# Previous key during a rotation (still accepted for reading).
# DATA_ENCRYPTION_KEY_PREVIOUS=
# Backups (default dir: <data dir>/backups; daily unless BACKUP_SCHEDULE=off).
# BACKUP_DIR=
# BACKUP_SCHEDULE=off
# Maximum size of an owner export ZIP, in bytes (default 400 MB).
# EXPORT_MAX_BYTES=

# ── Optional object storage (any S3-compatible store, incl. Supabase Storage) ─
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=https://<project-ref>.supabase.co/storage/v1/s3
# S3_REGION=eu-west-3
# S3_PREFIX=conviction/

# ── Models and limits ───────────────────────────────────────────────────────
# Primary multimodal reasoning model (Luna-first architecture).
CONVICTION_MODEL=gpt-5.6-luna
# Transcription model for founder-meeting recordings (diarized when available).
# CONVICTION_TRANSCRIBE_MODEL=gpt-4o-transcribe-diarize
# Analyses running at once; the rest queue (default 4).
# MAX_CONCURRENT_ANALYSES=4
# Cap per stale-source refresh in USD (default 0.06, bounded 0.02–0.25).
# REFRESH_BUDGET_USD=0.06
# Cap per meeting transcription in USD (default 3).
# MEETING_TRANSCRIPTION_CAP_USD=3
# Formation open-answer grading: model (default) or "heuristic" (no model call).
# FORMATION_GRADER=model
# The STANDARD analysis hard cap ($0.50) is enforced in code and is not configurable.

# ── Optional meeting integrations (Settings → Integrations shows the exact setup) ─
# Public URL of the app, used for OAuth redirect URIs (Render sets RENDER_EXTERNAL_URL automatically).
# APP_URL=https://conviction.example.com
# ZOOM_CLIENT_ID=
# ZOOM_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# ── Development only ───────────────────────────────────────────────────────
# Behind an egress proxy that injects credentials (Node >= 22.21): make fetch honor HTTPS_PROXY.
# NODE_USE_ENV_PROXY=1
# Point the app at scripts/mock-openai.ts or scripts/mock-integrations.ts for offline work.
# OPENAI_BASE_URL=http://127.0.0.1:4010/v1
# CONVICTION_INTEGRATIONS_MOCK_URL=http://127.0.0.1:4020
